{
  "audioCodecs": {
    "lossless": ["truehd", "dts-hd ma", "dtshd_ma", "dtsma", "dts-hd.ma", "flac", "alac", "pcm", "lpcm", "wav", "aiff"],
    "nearLossless": ["dts-hd hra", "dtshd_hra", "dts-hd.hra", "dtshra"],
    "highLossy": ["dts", "eac3", "ec-3", "dd+", "ddp", "dolby digital plus", "e-ac-3", "atsc a/52b"]
  },
  "tmdb": {
    "baseUrl": "https://api.themoviedb.org/3",
    "imageBaseUrl": "https://image.tmdb.org/t/p/",
    "cacheDuration": 86400000,
    "maxConcurrent": 10,
    "requestTimeout": 30000,
    "maxCacheSize": 1000,
    "rateLimitRequests": 40,
    "rateLimitWindowMs": 10000
  },
  "musicBrainz": {
    "requestIntervalMs": 1500,
    "maxAdaptiveDelayMs": 6000,
    "availabilityFailuresBeforeCooldown": 3,
    "availabilityCooldownMs": 60000
  },
  "logging": {
    "maxInfoEntries": 500,
    "maxImportantEntries": 500,
    "flushIntervalMs": 5000,
    "flushBufferSize": 50
  },
  "workers": {
    "ffprobe": {
      "maxQueueDepth": 10000,
      "defaultWorkersLimit": 4
    }
  },
  "monitoring": {
    "batchWindowMs": 45000,
    "maxIndividualNotifications": 10,
    "maxStoredNotifications": 100,
    "pollingIntervals": {
      "plex": 300000,
      "jellyfin": 300000,
      "emby": 300000,
      "kodi": 300000,
      "kodi-local": 60000,
      "kodi-mysql": 60000,
      "local": 60000,
      "mediamonkey": 60000
    }
  },
  "gemini": {
    "defaultModel": "gemini-flash-latest",
    "maxExplanationCache": 20
  },
  "quality": {
    "videoBitrateThresholds": {
      "SD": { "medium": 1500, "high": 3500 },
      "720p": { "medium": 3000, "high": 8000 },
      "1080p": { "medium": 6000, "high": 15000 },
      "4K": { "medium": 15000, "high": 40000 }
    },
    "audioBitrateThresholds": {
      "SD": { "medium": 128, "high": 192 },
      "720p": { "medium": 192, "high": 320 },
      "1080p": { "medium": 256, "high": 640 },
      "4K": { "medium": 320, "high": 1000 }
    },
    "codecEfficiency": {
      "h264": 1.0, "avc": 1.0, "x264": 1.0,
      "h265": 2.0, "hevc": 2.0, "x265": 2.0,
      "av1": 2.5,
      "vp9": 1.8
    },
    "musicThresholds": {
      "lowBitrate": 192,
      "highBitrate": 256,
      "hiResSampleRate": 44100,
      "hiResBitDepth": 16
    },
    "efficiencyTargets": {
      "SD": 1200,
      "720p": 2500,
      "1080p": 5000,
      "4K": 15000
    },
    "bloatThresholds": {
      "SD": 2500,
      "720p": 5000,
      "1080p": 10000,
      "4K": 30000
    },
    "minEfficiencyScore": 60,
    "hdrOverheadMultiplier": 1.10,
    "videoWeight": 0.7
  },
  "transcoding": {
    "defaultCrf": 20,
    "defaultPreset": "p6",
    "defaultSoftwarePreset": "medium",
    "defaultSoftwareCrf": 22,
    "defaultIntelPreset": "slow",
    "defaultIntelQuality": 20,
    "defaultAmdPreset": "balanced",
    "maxBitrateFallback": 60000000,
    "maxBufsizeFallback": 120000000,
    "audioSurroundTargetBitrateKbps": 640,
    "audioStereoTargetBitrateKbps": 256,
    "audioHeavyBitrateThresholdKbps": 1500,
    "hdrProbeDurationSeconds": 1,
    "encoderProbeWidth": 640,
    "encoderProbeHeight": 360,
    "sampleDurationSeconds": 30,
    "sampleQualities": [18, 22, 26],
    "qsvSampleQualities": [14, 16, 18, 22, 26],
    "samplePositions": [0.1, 0.5, 0.9]
  }
}
