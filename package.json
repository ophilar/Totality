{
    "name": "totality",
    "version": "0.5.1",
    "type": "module",
    "description": "Analyze media library quality and safely optimize media",
    "main": "dist-electron/main/index.cjs",
    "scripts": {
        "postinstall": "electron-builder install-app-deps",
        "dev": "vite",
        "build": "tsc && vite build && cross-env NODE_OPTIONS=--no-deprecation electron-builder",
        "lint": "oxlint --react-plugin --type-aware",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
        "preview": "vite preview",
        "electron:dev": "npm run dev",
        "electron:build": "npm run build",
        "generate-icons": "node scripts/generate-icons.js",
        "typecheck": "tsc --noEmit",
        "test": "tsc --noEmit && vitest run",
        "test:run": "npm run test",
        "test:acceptance": "cross-env TOTALITY_TEST_SUITE=acceptance vitest run",
        "test:media-integration": "cross-env TOTALITY_TEST_SUITE=media-integration vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "tsc --noEmit && vitest run --coverage",
        "release": "commit-and-tag-version"
    },
    "keywords": [
        "media",
        "quality",
        "upgrade",
        "electron",
        "plex",
        "jellyfin",
        "emby"
    ],
    "author": "",
    "license": "MIT",
    "sideEffects": false,
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "drizzle-orm": "^0.45.3",
        "electron-updater": "^6.8.9",
        "jsdom": "^30.1.1",
        "mysql2": "^3.24.5"
    },
    "overrides": {
        "follow-redirects": "1.16.0",
        "protobufjs": "^8.7.0",
        "keyv": "4.5.4",
        "flat-cache": "4.0.1",
        "file-entry-cache": "8.0.0"
    },
    "devDependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/modifiers": "9.0.0",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@google/genai": "^2.26.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/jsdom": "^30.0.0",
        "@types/node": "^26.6.4",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-istanbul": "^5.0.3",
        "@vitest/ui": "^5.0.3",
        "axios": "^1.20.0",
        "commit-and-tag-version": "^13.2.1",
        "cross-env": "10.1.0",
        "cssnano": "^9.1.2",
        "electron": "44.5.1",
        "electron-builder": "^26.15.3",
        "lucide-react": "^1.50.0",
        "oxlint": "^1.86.0",
        "oxlint-tsgolint": "^7.0.2003",
        "postcss": "^8.5.28",
        "prettier": "^3.9.9",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-virtualized-auto-sizer": "2.0.3",
        "react-virtuoso": "^4.18.16",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "typescript": "^7.0.2",
        "vite": "^8.3.2",
        "vite-plugin-electron": "^1.1.2",
        "vitest": "^5.0.3",
        "zod": "^4.6.5"
    }
}
