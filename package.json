{
  "name": "totality",
  "version": "0.5.0",
  "description": "Analyze media library quality and recommend upgrades",
  "main": "dist-electron/main/index.cjs",
  "scripts": {
    "postinstall": "electron-rebuild",
    "dev": "vite",
    "build": "npm run build:app",
    "lint": "oxlint --react-plugin --deny-warnings",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "electron:dev": "vite",
    "electron:build": "npm run build:app",
    "build:app": "npm run generate-windows-icon && npm run test:run && npm run typecheck && npm run renderer:build && npm run package:electron",
    "generate-windows-icon": "node scripts/generate-icons.js --windows-only",
    "renderer:build": "vite build",
    "package:electron": "node scripts/package-electron.cjs",
    "generate-icons": "node scripts/generate-icons.js",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "release": "standard-version",
    "release:beta": "standard-version --prerelease beta",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "keywords": [
    "media",
    "quality",
    "upgrade",
    "electron",
    "plex",
    "jellyfin",
    "emby"
  ],
  "author": "Brandon Bidwell",
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {
    "@google/genai": "^2.30.0",
    "adm-zip": "^0.6.1",
    "better-sqlite3": "^13.0.3",
    "chokidar": "^5.0.0",
    "css-select": "^7.0.0",
    "domhandler": "^6.0.1",
    "domutils": "^4.0.2",
    "electron-updater": "^6.8.9",
    "htmlparser2": "^12.0.0",
    "selfsigned": "^5.5.0",
    "ws": "^8.22.0",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "mysql2": "^3.24.6",
    "sql.js": "^1.15.0"
  },
  "devDependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@sqlite.org/sqlite-wasm": "^3.53.4-build2",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-istanbul": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "cssnano": "^9.9.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2",
    "lucide-react": "^1.59.0",
    "oxlint": "^1.88.0",
    "postcss": "^8.5.30",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-window": "^2.3.4",
    "sharp": "^0.35.5",
    "standard-version": "^9.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-electron": "^1.1.2",
    "vite-plugin-electron-renderer": "^1.0.0",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "@electron/get": "^5.1.0",
    "tsyringe": {
      "tslib": "^2.8.1"
    }
  }
}
