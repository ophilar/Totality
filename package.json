{
    "name": "totality",
    "version": "0.4.4",
    "type": "module",
    "description": "Analyze media library quality and recommend upgrades",
    "main": "dist-electron/main/index.cjs",
    "scripts": {
        "postinstall": "electron-builder install-app-deps",
        "dev": "vite",
        "build": "tsc && vite build && cross-env NODE_OPTIONS=--no-deprecation electron-builder",
        "lint": "eslint",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
        "preview": "vite preview",
        "electron:dev": "vite",
        "electron:build": "tsc && vite build && cross-env NODE_OPTIONS=--no-deprecation electron-builder",
        "generate-icons": "node scripts/generate-icons.js",
        "typecheck": "tsc --noEmit",
        "test": "tsc --noEmit && vitest run",
        "test:run": "tsc --noEmit && vitest run",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "tsc --noEmit && vitest run --coverage",
        "release": "standard-version"
    },
    "keywords": [
        "media",
        "quality",
        "upgrade",
        "electron",
        "plex",
        "jellyfin",
        "emby"
    ],
    "author": "",
    "license": "MIT",
    "sideEffects": false,
    "dependencies": {
        "@libsql/client": "^0.17.3",
        "drizzle-orm": "^0.45.2",
        "electron-updater": "^6.8.9",
        "mysql2": "^3.23.3",
        "p-limit": "^3.1.0",
        "yocto-queue": "^0.1.0"
    },
    "overrides": {
        "follow-redirects": "1.16.0",
        "protobufjs": "^8.7.0",
        "keyv": "4.5.4",
        "flat-cache": "4.0.1",
        "file-entry-cache": "8.0.0"
    },
    "devDependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/modifiers": "9.0.0",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@eslint/js": "^9.39.5",
        "@google/genai": "^2.17.1",
        "@tailwindcss/postcss": "^4.3.0",
        "@testing-library/dom": "10.4.1",
        "@testing-library/react": "16.3.2",
        "@types/adm-zip": "0.5.8",
        "@types/node": "^24.13.3",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.0.5",
        "@vitest/coverage-istanbul": "^4.1.6",
        "@vitest/coverage-v8": "^4.1.6",
        "@vitest/ui": "^4.1.6",
        "adm-zip": "^0.6.0",
        "axios": "^1.19.0",
        "cross-env": "10.1.0",
        "cssnano": "^8.0.6",
        "electron": "^43.4.0",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.4",
        "globals": "^17.11.0",
        "jsdom": "^30.0.1",
        "lucide-react": "^1.32.0",
        "postcss": "^8.5.26",
        "prettier": "^3.9.5",
        "react": "^19.2.6",
        "react-dom": "^19.2.6",
        "react-virtualized-auto-sizer": "2.0.3",
        "react-virtuoso": "^4.18.12",
        "sharp": "^0.35.3",
        "standard-version": "9.5.0",
        "tailwindcss": "^4.3.0",
        "typescript": "~5.6.3",
        "typescript-eslint": "^8.67.0",
        "vite": "^8.2.1",
        "vite-plugin-electron": "^1.1.1",
        "vite-plugin-electron-renderer": "^1.0.0",
        "vitest": "^4.1.6",
        "zod": "^4.4.3"
    }
}
