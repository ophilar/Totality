{
    "name": "totality",
    "version": "0.5.1",
    "type": "module",
    "description": "Analyze media library quality and safely optimize media",
    "main": "dist-electron/main/index.cjs",
    "scripts": {
        "postinstall": "electron-builder install-app-deps",
        "dev": "vite",
        "build": "tsc && vite build && cross-env NODE_OPTIONS=--no-deprecation electron-builder",
        "lint": "eslint",
        "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
        "preview": "vite preview",
        "electron:dev": "npm run dev",
        "electron:build": "npm run build",
        "generate-icons": "node scripts/generate-icons.js",
        "typecheck": "tsc --noEmit",
        "test": "tsc --noEmit && vitest run",
        "test:run": "npm run test",
        "test:watch": "vitest",
        "test:ui": "vitest --ui",
        "test:coverage": "tsc --noEmit && vitest run --coverage",
        "release": "standard-version"
    },
    "keywords": [
        "media",
        "quality",
        "upgrade",
        "electron",
        "plex",
        "jellyfin",
        "emby"
    ],
    "author": "",
    "license": "MIT",
    "sideEffects": false,
    "dependencies": {
        "@libsql/client": "^0.18.0",
        "drizzle-orm": "^0.45.2",
        "electron-updater": "^6.8.9",
        "mysql2": "^3.24.4",
        "yocto-queue": "^1.2.2"
    },
    "overrides": {
        "follow-redirects": "1.16.0",
        "protobufjs": "^8.7.0",
        "keyv": "4.5.4",
        "flat-cache": "4.0.1",
        "file-entry-cache": "8.0.0"
    },
    "devDependencies": {
        "@dnd-kit/core": "6.3.1",
        "@dnd-kit/modifiers": "9.0.0",
        "@dnd-kit/sortable": "10.0.0",
        "@dnd-kit/utilities": "3.2.2",
        "@eslint/js": "^9.39.5",
        "@google/genai": "^2.23.0",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/dom": "10.4.2",
        "@testing-library/react": "^16.3.3",
        "@types/adm-zip": "0.5.8",
        "@types/node": "^26.6.2",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.1",
        "@vitest/coverage-istanbul": "^5.0.1",
        "@vitest/coverage-v8": "^5.0.1",
        "@vitest/ui": "^5.0.1",
        "adm-zip": "^0.6.1",
        "axios": "^1.20.0",
        "cross-env": "10.1.0",
        "cssnano": "^9.0.5",
        "electron": "44.4.3",
        "electron-builder": "^26.15.3",
        "esbuild": "^0.28.2",
        "eslint": "^9.39.5",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.12.0",
        "jsdom": "^30.1.0",
        "lucide-react": "^1.47.0",
        "playwright": "^1.63.0",
        "postcss": "^8.5.28",
        "prettier": "^3.9.8",
        "react": "^19.3.0",
        "react-dom": "^19.3.0",
        "react-virtualized-auto-sizer": "2.0.3",
        "react-virtuoso": "^4.18.13",
        "sharp": "^0.35.4",
        "standard-version": "9.5.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.6.3",
        "typescript-eslint": "^8.70.0",
        "vite": "^8.3.0",
        "vite-plugin-electron": "^1.1.2",
        "vite-plugin-electron-renderer": "^1.0.0",
        "vitest": "^5.0.1",
        "zod": "^4.6.5"
    }
}
